# ==========================================
# Audiwav Database Configuration
# ==========================================

# PostgreSQL host.
DB_HOST=localhost

# PostgreSQL port.
DB_PORT=5432

# PostgreSQL username.
DB_USER=audiwav

# PostgreSQL password.
DB_PASSWORD=your_password

# ==========================================
# Canonical Music Metadata Database
# ==========================================

# Nama database yang berisi dataset Canonical MusicBrainz.
CANONICAL_DB_NAME=canonical

# Connection string untuk koneksi ke database Canonical.
CANONICAL_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${CANONICAL_DB_NAME}

# ==========================================
# RustFS S3 Storage Credentials
# ==========================================
# RustFS kompatibel dengan S3 API (default port: 9000).
# Nilai default di docker-compose.yml:
# - Access Key: 20 karakter alfanumerik acak
# - Secret Key: 40 karakter alfanumerik acak
#
# Cara generate key baru jika diperlukan:
#   openssl rand -hex 10  # untuk RUSTFS_ACCESS_KEY (20 karakter)
#   openssl rand -base64 30 | tr -dc 'a-zA-Z0-9' | head -c 40  # untuk RUSTFS_SECRET_KEY (40 karakter)
RUSTFS_ACCESS_KEY=your_rustfs_access_key
RUSTFS_SECRET_KEY=your_rustfs_secret_key

# ==========================================
# SLSKD P2P Engine Credentials
# ==========================================
# SLSKD adalah daemon Soulseek headless yang berjalan di background (default Web UI port: 5030).
#
# 1. SLSKD Web UI & Application:
#    - SLSKD_USERNAME: Username untuk login ke Web UI SLSKD (bebas ditentukan)
#    - SLSKD_PASSWORD: Password login ke Web UI SLSKD (bisa string acak atau password Anda)
#    - SLSKD_API_KEY: API Key untuk komunikasi backend Audiwav dengan REST API SLSKD.
#      Cara generate API Key:
#        openssl rand -hex 16
#
# 2. Akun Jaringan Soulseek (P2P Network):
#    - SLSKD_SLSK_USERNAME: Username akun jaringan Soulseek Anda (daftar gratis via Nicotine+ atau client Soulseek)
#    - SLSKD_SLSK_PASSWORD: Password akun jaringan Soulseek Anda
SLSKD_USERNAME=audiwav_music_library
SLSKD_PASSWORD=your_slskd_web_password
SLSKD_API_KEY=your_slskd_api_key
SLSKD_SLSK_USERNAME=your_soulseek_network_username
SLSKD_SLSK_PASSWORD=your_soulseek_network_password
